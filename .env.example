# Chiave API OpenAI: usata solo lato server, mai esposta al browser.
OPENAI_API_KEY=

# Autenticazione Google tramite AWS Cognito (attiva in produzione, disattivata nelle anteprime Vercel).
# App Client pubblico con PKCE: nessun client secret.
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Dominio della Hosted UI, es. example.auth.eu-west-1.amazoncognito.com
COGNITO_LOGIN_DOMAIN=
# Solo gli utenti di questo gruppo Cognito possono accedere.
COGNITO_ALLOWED_GROUP=
# Segreto per cifrare il cookie di sessione (stringa casuale lunga, es. openssl rand -base64 32).
AUTH_SECRET=
